{"is_source_file": true, "format": "JavaScript", "description": "This file implements an Offline Synchronization Service for a notes application. It handles detecting network connectivity, queuing mutations (create, update, delete, archive, unarchive) when offline, performing background synchronization upon reconnect, resolving conflicts via last-write-wins with version history fallback, and merging server and local notes. Key functionalities include subscribing to connectivity changes, applying queued mutations to the server, merging notes, and providing various queueing functions for mutate operations. It also exports an interface for hydrating notes, which fetches from the server and merges with local data.", "external_files": ["./indexedDb", "./notesService"], "external_methods": ["idbQueueMutation", "idbReadQueue", "idbRemoveQueueItemsByIds", "idbGetAllNotes", "idbUpsertNote", "idbDeleteNoteById", "idbSaveNotes", "idbGetMeta", "idbSetMeta", "fetchNotes", "createNote", "updateNote", "deleteNote", "archiveNote", "unarchiveNote"], "published": ["isOnline", "subscribeConnectivity", "backgroundSync", "queueCreate", "queueUpdate", "queueDelete", "queueArchive", "queueUnarchive", "hydrateNotes"], "classes": [], "methods": [{"name": "isOnline()", "description": "Returns true if the browser's navigator reports the application is online.", "scope": "", "scopeKind": ""}, {"name": "subscribeConnectivity(cb)", "description": "Allows other parts of the application to subscribe to connectivity status changes; returns an unsubscribe function.", "scope": "", "scopeKind": ""}, {"name": "backgroundSync()", "description": "Performs background synchronization: applies queued mutations to the server, then merges server and local notes, updating local storage.", "scope": "", "scopeKind": ""}, {"name": "queueCreate(noteBody)", "description": "Queues a create note operation. If online, attempts immediate creation; otherwise, queues for later sync.", "scope": "", "scopeKind": ""}, {"nam