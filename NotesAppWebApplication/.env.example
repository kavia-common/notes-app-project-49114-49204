# React app environment variables (do not commit real .env with secrets)
# Copy this file to .env and adjust values as needed.

# The port the CRA dev server should bind to.
REACT_APP_PORT=3000

# The host interface to bind to; 0.0.0.0 enables access from outside the container.
REACT_APP_HOST=0.0.0.0

# Node environment as used by React application code (does not override NODE_ENV if set).
REACT_APP_NODE_ENV=development

# URLs used by the app for API and frontend. Update to match your deployment.
REACT_APP_API_BASE=http://localhost:8000/api
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000

# Websocket base URL if applicable.
REACT_APP_WS_URL=ws://localhost:8000/ws

# Disable Next.js telemetry style var (not used here, but present in container env).
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Enable or disable source maps in development.
REACT_APP_ENABLE_SOURCE_MAPS=true

# Trust proxy setting placeholder (not used directly by CRA).
REACT_APP_TRUST_PROXY=true

# Logging level for app code.
REACT_APP_LOG_LEVEL=info

# Healthcheck path for preview system. We place a static file in /public/healthz.txt
REACT_APP_HEALTHCHECK_PATH=/healthz.txt

# Feature flags and experiments placeholders.
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
