{
  "name": "notesapp-webapplication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${REACT_APP_PORT:-3000}",
    "dev:backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port ${BACKEND_PORT:-5179} --reload",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${REACT_APP_PORT:-3000}",
    "start": "vite --host 0.0.0.0 --port ${REACT_APP_PORT:-3000}"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "vite": "^5.4.8"
  }
}
