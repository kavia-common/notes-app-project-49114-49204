# Frontend dev server port (Vite)
REACT_APP_PORT=3000

# Use relative API base to ensure Vite proxy is used in development
REACT_APP_API_BASE=/api

# Leave BACKEND_URL empty to prefer proxy during development
REACT_APP_BACKEND_URL=

# Optional values
REACT_APP_FRONTEND_URL=
# Use relative websocket path so Vite proxy routes to backend
REACT_APP_WS_URL=/ws
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false

# Backend dev port (used by uvicorn and Vite proxy target)
BACKEND_PORT=5179

# Optional: preview host allowance for Vite allowedHosts
# PREVIEW_HOST=vscode-internal-31398-qa.qa01.cloud.kavia.ai
